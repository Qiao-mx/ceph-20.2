    cookie.parse(\(dqcookie1=value1; cookie2=value2; cookie3=value3\(dq);
    cookie.keep_re(\(dq^cookie[12]$\(dq);
    # get_string() will now yield \(dqcookie1=value1; cookie2=value2\(dq
}
